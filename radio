cat <<EOF > /etc/nginx/sites-available/radio
upstream icecast     { server 127.0.0.1:8000; }
upstream filebrowser { server 127.0.0.1:8080; }
upstream liquidsoap  { server 127.0.0.1:8005; }

# ---- Rate Limiting ----
limit_req_zone \$binary_remote_addr zone=radio:10m rate=10r/s;
limit_conn_zone \$binary_remote_addr zone=conn_limit:10m;

# ---- Bot Detection ----
# Block known bad User-Agents
map \$http_user_agent \$blocked_ua {
    default 0;
    
    # Stream rippers
    ~*(StreamRipper|IcecastRipper|ShoutcastRipper|ripper|Ripper) 1;
    ~*(youtube-dl|you-get|wget|curl|python-requests) 1;
    ~*(libwww-perl|java|php|perl) 1;
    ~*(masscan|nmap|zmap|nikto|sqlmap) 1;
    
    # Aggressive crawlers/bots
    ~*(semrush|ahrefs|majestic|rogerbot|dotbot|bingbot|slurp) 1;
    ~*(MJ12bot|AhrefsBot|SemrushBot|DotBot|BLEXBot|PetalBot) 1;
    ~*(DuckDuckBot|Baiduspider|YandexBot|Sogou|Exabot) 1;
    
    # Empty User-Agent (often bots)
    "" 1;
}

# Block direct IP access (only allow via domain)
map \$host \$blocked_host {
    default 1;
    ${DOMAIN} 0;
    ${PLAY_DOMAIN} 0;
    ${FILES_DOMAIN} 0;
    ${DJ_DOMAIN} 0;
}

# ---- Main domain ----
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ${DOMAIN};

    root /var/www/domain;
    index index.php index.html;

    # Rate limiting for all requests
    limit_req zone=radio burst=20 nodelay;
    limit_conn conn_limit 10;

    # Bot protection for all requests
    if (\$blocked_ua) {
        return 403;
    }
    
    if (\$blocked_host) {
        return 403;
    }

    # PHP support
    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass ${PHP_FPM_SOCKET};
        fastcgi_param SCRIPT_FILENAME \$document_root\$fastcgi_script_name;
        include fastcgi_params;
    }

    location / {
        try_files \$uri \$uri/ =404;
    }
}

# ---- play subdomain ----
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ${PLAY_DOMAIN};

    # Rate limiting for all requests
    limit_req zone=radio burst=20 nodelay;
    limit_conn conn_limit 10;

    # Bot protection for all requests
    if (\$blocked_ua) { return 403; }
    if (\$blocked_host) { return 403; }

    # Allow Icecast status endpoints (needed for "Now Playing" JS fetch)
    location = /status-json.xsl {
        proxy_pass http://icecast/status-json.xsl;
        proxy_set_header Host \$host;
        add_header Access-Control-Allow-Origin *;
    }

    location = /status.xsl {
        proxy_pass http://icecast/status.xsl;
        proxy_set_header Host \$host;
    }

    # Proxy everything else to the live stream
    location / {
        proxy_pass http://icecast/live.mp3;
        proxy_buffering off;
        
        # Stricter limits for stream
        limit_req zone=radio burst=10 nodelay;
        limit_conn conn_limit 5;
        
        # Headers
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
        
        # Hide that we're proxying Icecast
        proxy_hide_header Server;
        proxy_set_header Server "nginx";
    }

    location ~ ^/(admin|stats) {
        return 404;
    }
}

# ---- files subdomain ----
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ${FILES_DOMAIN};

    auth_basic "Restricted Area";
    auth_basic_user_file /etc/nginx/.htpasswd_files;
    client_max_body_size 500M;

    # Rate limiting for file uploads
    limit_req zone=radio burst=5 nodelay;
    limit_conn conn_limit 3;

    # Bot protection
    if (\$blocked_ua) {
        return 403;
    }

    location / {
        proxy_pass http://filebrowser;
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
    }
}

# ---- dj subdomain ----
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ${DJ_DOMAIN};

    auth_basic "DJ Area";
    auth_basic_user_file /etc/nginx/.htpasswd_dj;

    # Rate limiting for DJ connections
    limit_req zone=radio burst=5 nodelay;
    limit_conn conn_limit 2;

    # Bot protection
    if (\$blocked_ua) {
        return 403;
    }

    location / {
        proxy_pass http://liquidsoap;
        proxy_buffering off;
        proxy_request_buffering off;
        client_max_body_size 0;
        proxy_read_timeout 3600s;
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
    }
}

# ---- HTTP to HTTPS redirect ----
server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN} ${PLAY_DOMAIN} ${FILES_DOMAIN} ${DJ_DOMAIN};
    
    # Rate limiting for redirects
    limit_req zone=radio burst=20 nodelay;
    limit_conn conn_limit 10;
    
    return 301 https://\$host\$request_uri;
}
