    <script>
        const audio = document.getElementById('radioPlayer');
        const vinylWrapper = document.getElementById('vinylWrapper');

        audio.volume = 0.8;

        document.addEventListener('DOMContentLoaded', function() {
            audio.play().catch(function(err) {
                const nowPlaying = document.getElementById('nowPlayingText');
                if (nowPlaying) {
                    nowPlaying.textContent = '🎵 Click play to start listening';
                }
                console.log('Auto-play blocked:', err.message);
            });
        });

        audio.addEventListener('play', function() {
            vinylWrapper.classList.add('playing');
        });

        audio.addEventListener('pause', function() {
            vinylWrapper.classList.remove('playing');
        });

        async function fetchNowPlaying() {
            const el = document.getElementById('nowPlayingText');
            try {
                const res = await fetch('https://<?php echo htmlspecialchars($PLAY_DOMAIN); ?>/status-json.xsl', {
                    method: 'GET',
                    headers: { 'Accept': 'application/json' },
                    mode: 'cors'
                });

                if (!res.ok) {
                    el.textContent = '🎵 Now playing: Unknown track';
                    return;
                }

                const data = await res.json();
                const source = data?.icestats?.source;
                if (source && Array.isArray(source) && source.length > 0) {
                    const latest = source[source.length - 1];
                    const title = latest?.title || 'Unknown track';
                    const artist = latest?.artist || '';
                    el.textContent = `🎵 ${artist ? artist + ' – ' : ''}${title}`;
                } else {
                    el.textContent = '🎵 Now playing: Unknown track';
                }
            } catch (err) {
                if (!el.textContent.includes('Click play')) {
                    el.textContent = '🎵 Tune in to hear the vibe!';
                }
                console.log('Now playing fetch error:', err.message);
            }
        }

        setTimeout(fetchNowPlaying, 1000);
        setInterval(fetchNowPlaying, 30000);

        function copyStreamUrl() {
            const url = document.getElementById('streamUrl').textContent;
            const btn = document.getElementById('copyBtn');
            
            navigator.clipboard.writeText(url).then(() => {
                btn.innerHTML = '<i class="fas fa-check"></i> Copied!';
                btn.classList.add('copied');
                setTimeout(() => {
                    btn.innerHTML = '<i class="fas fa-copy"></i> Copy';
                    btn.classList.remove('copied');
                }, 3000);
            }).catch(() => {
                const input = document.createElement('input');
                input.value = url;
                document.body.appendChild(input);
                input.select();
                document.execCommand('copy');
                document.body.removeChild(input);
                btn.innerHTML = '<i class="fas fa-check"></i> Copied!';
                btn.classList.add('copied');
                setTimeout(() => {
                    btn.innerHTML = '<i class="fas fa-copy"></i> Copy';
                    btn.classList.remove('copied');
                }, 3000);
            });
        }

        document.querySelectorAll('.copy-btn, .socials a, .vinyl-wrapper').forEach(el => {
            el.addEventListener('touchstart', function() {
                this.style.transition = 'transform 0.1s ease';
            });
        });

        document.addEventListener('dblclick', (e) => e.preventDefault());
    </script>
