done
EOF

chmod +x /usr/local/bin/manage-radio-users

echo -e "${GREEN}✅ User management script created: /usr/local/bin/manage-radio-users${NC}"
echo -e "${GREEN}You can run it anytime to add/remove users.${NC}"
echo ""
echo -e "${GREEN}Enjoy your radio! 🎶${NC}"
