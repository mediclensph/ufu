#!/bin/bash

set -euo pipefail

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo -e "${GREEN}========================================${NC}"
echo -e "${GREEN}    Secure Icecast Radio Installer     ${NC}"
echo -e "${GREEN}========================================${NC}"

# ---- Gather input ----
echo ""
read -p "Enter your main domain (e.g., example.com): " DOMAIN
if [ -z "$DOMAIN" ]; then
    echo -e "${RED}Error: Domain cannot be empty${NC}"
    exit 1
fi

echo ""
read -p "Enter your radio station name: " RADIO_NAME
if [ -z "$RADIO_NAME" ]; then
    RADIO_NAME="My Radio"
    echo -e "${YELLOW}Using default radio name: ${RADIO_NAME}${NC}"
fi

# Subdomains
PLAY_DOMAIN="play.${DOMAIN}"
FILES_DOMAIN="files.${DOMAIN}"
DJ_DOMAIN="dj.${DOMAIN}"

echo -e "${YELLOW}Using subdomains:${NC}"
echo "  - Main website: ${DOMAIN}"
echo "  - Listeners: ${PLAY_DOMAIN}"
echo "  - File manager: ${FILES_DOMAIN}"
echo "  - DJ source: ${DJ_DOMAIN}"
echo "  - Radio name: ${RADIO_NAME}"
echo ""
read -p "Is this correct? (y/n): " CONFIRM
if [[ ! "$CONFIRM" =~ ^[Yy]$ ]]; then
    echo "Exiting..."
    exit 0
fi

read -p "Enter your email for Let's Encrypt (optional, press Enter to skip): " EMAIL

# ---- Initial users ----
echo ""
echo -e "${GREEN}Setting up initial users...${NC}"

read -p "Enter username for FileBrowser (admin): " FB_USER
FB_USER=${FB_USER:-admin}
read -sp "Enter password for FileBrowser: " FB_PASS
echo ""
if [ -z "$FB_PASS" ]; then
    echo -e "${RED}Password cannot be empty${NC}"
    exit 1
fi

echo ""
read -p "Enter username for DJ (live source): " DJ_USER
DJ_USER=${DJ_USER:-dj}
read -sp "Enter password for DJ: " DJ_PASS
echo ""
if [ -z "$DJ_PASS" ]; then
    echo -e "${RED}Password cannot be empty${NC}"
    exit 1
fi

# Auto-generate Icecast passwords
ICECAST_SOURCE_PASS=$(openssl rand -base64 24 | tr -d '/+=')
ICECAST_RELAY_PASS=$(openssl rand -base64 24 | tr -d '/+=')
ICECAST_ADMIN_PASS=$(openssl rand -base64 24 | tr -d '/+=')

echo ""
echo -e "${YELLOW}Generated Icecast passwords:${NC}"
echo "  Source password: ${ICECAST_SOURCE_PASS}"
echo "  Relay password:  ${ICECAST_RELAY_PASS}"
echo "  Admin password:  ${ICECAST_ADMIN_PASS}"
echo ""
echo "Please save these somewhere safe."
echo ""

# Save radio config
mkdir -p /etc/radio
cat <<EOF > /etc/radio/config
# Radio Configuration
RADIO_NAME="${RADIO_NAME}"
DOMAIN="${DOMAIN}"
PLAY_DOMAIN="${PLAY_DOMAIN}"
FILES_DOMAIN="${FILES_DOMAIN}"
DJ_DOMAIN="${DJ_DOMAIN}"
ICECAST_SOURCE_PASS="${ICECAST_SOURCE_PASS}"
ICECAST_RELAY_PASS="${ICECAST_RELAY_PASS}"
ICECAST_ADMIN_PASS="${ICECAST_ADMIN_PASS}"
EOF

# ---- System update and packages ----
echo -e "${GREEN}Updating system and installing packages...${NC}"
DEBIAN_FRONTEND=noninteractive apt update && DEBIAN_FRONTEND=noninteractive apt upgrade -y
DEBIAN_FRONTEND=noninteractive apt install -y nginx icecast2 liquidsoap fail2ban ufw curl certbot python3-certbot-nginx php-fpm php-common

# ---- FileBrowser ----
echo -e "${GREEN}Installing FileBrowser...${NC}"
curl -fsSL https://raw.githubusercontent.com/filebrowser/get/master/get.sh | bash

mkdir -p /var/music
chown www-data:www-data /var/music

# Initialize FileBrowser database and create admin user
filebrowser -d /etc/filebrowser.db config init
filebrowser -d /etc/filebrowser.db config set --address=127.0.0.1 --port=8080
filebrowser -d /etc/filebrowser.db config set --auth.method=json
filebrowser -d /etc/filebrowser.db users add "$FB_USER" "$FB_PASS" --perm.admin
chown www-data:www-data /etc/filebrowser.db

cat <<EOF > /etc/systemd/system/filebrowser.service
[Unit]
Description=File Browser
After=network.target

[Service]
ExecStart=/usr/local/bin/filebrowser -r /var/music -a 127.0.0.1 -p 8080 -d /etc/filebrowser.db
Restart=always
User=www-data
Group=www-data

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable filebrowser
systemctl start filebrowser

# ---- Icecast ----
echo -e "${GREEN}Configuring Icecast...${NC}"
# Backup original config
cp /etc/icecast2/icecast.xml /etc/icecast2/icecast.xml.backup

# Set bind address
sed -i 's/<bind-address>.*<\/bind-address>/<bind-address>127.0.0.1<\/bind-address>/' /etc/icecast2/icecast.xml

# Set passwords
sed -i "s/<source-password>.*<\/source-password>/<source-password>${ICECAST_SOURCE_PASS}<\/source-password>/" /etc/icecast2/icecast.xml
sed -i "s/<relay-password>.*<\/relay-password>/<relay-password>${ICECAST_RELAY_PASS}<\/relay-password>/" /etc/icecast2/icecast.xml
sed -i "s/<admin-password>.*<\/admin-password>/<admin-password>${ICECAST_ADMIN_PASS}<\/admin-password>/" /etc/icecast2/icecast.xml

# Add mount restriction for MP3 only
sed -i '/<\/icecast>/i \
    <mount>\n        <mount-name>\/live.mp3<\/mount-name>\n        <type>application\/mpeg<\/type>\n        <bitrate>128<\/bitrate>\n    <\/mount>' /etc/icecast2/icecast.xml

systemctl enable icecast2
systemctl start icecast2

# ---- Liquidsoap ----
echo -e "${GREEN}Configuring Liquidsoap...${NC}"
mkdir -p /etc/liquidsoap 
mkdir -p /var/log/liquidsoap
chown -R liquidsoap:liquidsoap /var/log/liquidsoap 2>/dev/null || chown -R icecast2:icecast /var/log/liquidsoap

cat <<EOF > /etc/liquidsoap/radio.liq
#!/usr/bin/liquidsoap
set("log.file.path", "/var/log/liquidsoap/radio.log")
set("log.level", 3)

playlist = playlist("/var/music", reload_mode="watch")
safe_playlist = crossfade(playlist)

# DJ input on port 8005 (localhost only)
dj = input.harbor("dj", port=8005, password="${DJ_PASS}")

# Fallback uses the crossfaded playlist
radio = fallback(track_sensitive=true, [dj, safe_playlist])

output.icecast(
    %mp3(bitrate=128, samplerate=44100, stereo=true),
    host="127.0.0.1",
    port=8000,
    password="${ICECAST_SOURCE_PASS}",
    mount="/live.mp3",
    radio
)
EOF

# Create a dedicated systemd service
cat <<EOF > /etc/systemd/system/liquidsoap.service
[Unit]
Description=Liquidsoap Radio Automation
After=network.target icecast2.service

[Service]
ExecStart=/usr/bin/liquidsoap /etc/liquidsoap/radio.liq
Restart=always
User=liquidsoap
Group=liquidsoap

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable liquidsoap
systemctl start liquidsoap

# ---- UFW: Cloudflare only ----
echo -e "${GREEN}Configuring UFW with Cloudflare IPs...${NC}"
curl -s https://www.cloudflare.com/ips-v4 -o /tmp/cloudflare_ips_$$
echo "" >> /tmp/cloudflare_ips_$$
curl -s https://www.cloudflare.com/ips-v6 >> /tmp/cloudflare_ips_$$

# Reset the firewall to clean stuff.
ufw --force reset
ufw default deny incoming
ufw default allow outgoing

ufw limit ssh
for ip in $(cat /tmp/cloudflare_ips_$$)
do
  # Skip empty lines just in case
  [ -n "$ip" ] && ufw allow proto tcp from "$ip" to any port 80,443 comment 'Cloudflare'
done
# Make sure the firewall is enabled and started, as the above command
# stops it.
ufw enable
ufw reload > /dev/null
ufw status numbered
rm -rf /tmp/cloudflare_ips_$$

# ---- Create Cloudflare update script ----
cat <<'EOF' > /usr/local/bin/update-cloudflare-ufw
#!/bin/bash
# Update Cloudflare IPs in UFW
# WARNING: This removes ALL rules with 'Cloudflare' comment

curl -s https://www.cloudflare.com/ips-v4 -o /tmp/cloudflare_ips_$$
echo "" >> /tmp/cloudflare_ips_$$
curl -s https://www.cloudflare.com/ips-v6 >> /tmp/cloudflare_ips_$$

# Remove old Cloudflare rules
ufw status numbered | grep 'Cloudflare' | awk '{print $1}' | tr -d '[]' | tac | while read rule; do
    echo "y" | ufw delete $rule 2>/dev/null || true
done

for ip in $(cat /tmp/cloudflare_ips_$$); do
    ufw allow proto tcp from "$ip" to any port 80,443 comment 'Cloudflare'
done

ufw reload > /dev/null
ufw status numbered
rm -rf /tmp/cloudflare_ips_$$
EOF
chmod +x /usr/local/bin/update-cloudflare-ufw

# ---- Schedule Cloudflare IP updates ----
echo -e "${GREEN}Scheduling weekly Cloudflare IP updates...${NC}"
# Remove any existing update-cloudflare-ufw cron jobs to prevent duplicates
(crontab -l 2>/dev/null | grep -v 'update-cloudflare-ufw'; echo "0 3 * * 1 /usr/local/bin/update-cloudflare-ufw") | crontab - 2>/dev/null || true
echo -e "${GREEN}✅ Weekly Cloudflare IP updates scheduled!${NC}"

# Detect PHP-FPM socket dynamically to prevent 502 Bad Gateway
PHP_FPM_SOCKET=$(ls /run/php/php*-fpm.sock 2>/dev/null | head -n 1)
if [ -z "$PHP_FPM_SOCKET" ]; then
    PHP_FPM_SOCKET="unix:/var/run/php/php-fpm.sock"
fi

