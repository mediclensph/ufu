cat <<EOF > /etc/fail2ban/jail.d/stream-ripper.local
[stream-ripper]
enabled = true
filter = stream-ripper
logpath = /var/log/nginx/*access.log
maxretry = 3
bantime = 24h
EOF

systemctl enable fail2ban
systemctl restart fail2ban

# ---- SSL (if DNS ready) ----
echo ""
echo -e "${YELLOW}========================================${NC}"
echo -e "${YELLOW}IMPORTANT: DNS must point to this server${NC}"
echo -e "${YELLOW}Cloudflare DNS - Orange Cloud ON must be set${NC}"
echo -e "${YELLOW}========================================${NC}"
read -p "Has DNS been configured for ${DOMAIN} and subdomains? (y/n): " DNS_READY

if [[ "$DNS_READY" =~ ^[Yy]$ ]]; then
    if [ -n "$EMAIL" ]; then
        certbot --nginx -d "${DOMAIN}" -d "${PLAY_DOMAIN}" -d "${FILES_DOMAIN}" -d "${DJ_DOMAIN}" --email "${EMAIL}" --non-interactive --agree-tos
    else
        echo -e "${YELLOW}No email provided. Using --register-unsafely-without-email${NC}"
        certbot --nginx -d "${DOMAIN}" -d "${PLAY_DOMAIN}" -d "${FILES_DOMAIN}" -d "${DJ_DOMAIN}" --register-unsafely-without-email --non-interactive --agree-tos
    fi
    systemctl reload nginx
    echo -e "${GREEN}✅ SSL certificate installed!${NC}"
else
    echo -e "${YELLOW}⚠️  Skipping SSL certificate installation.${NC}"
    echo -e "${YELLOW}   Run later: sudo certbot --nginx -d ${DOMAIN} -d ${PLAY_DOMAIN} -d ${FILES_DOMAIN} -d ${DJ_DOMAIN}${NC}"
fi

# ---- USER MANAGEMENT FUNCTIONS ----
manage_users() {
    while true; do
        echo ""
        echo -e "${GREEN}========================================${NC}"
        echo -e "${GREEN}      User Management Menu            ${NC}"
        echo -e "${GREEN}========================================${NC}"
        echo ""
        echo "1. Add FileBrowser user (files.${DOMAIN})"
        echo "2. Remove FileBrowser user"
        echo "3. List FileBrowser users"
        echo "4. Add DJ user (dj.${DOMAIN})"
        echo "5. Remove DJ user"
        echo "6. List DJ users"
        echo "7. Exit user management"
        echo ""
        read -p "Select option (1-7): " USER_OPTION

        case $USER_OPTION in
            1)
                read -p "Enter new FileBrowser username: " NEW_FB_USER
                if [ -z "$NEW_FB_USER" ]; then
                    echo -e "${RED}Username cannot be empty${NC}"
                    continue
                fi
                read -sp "Enter password for ${NEW_FB_USER}: " NEW_FB_PASS
                echo ""
                if [ -z "$NEW_FB_PASS" ]; then
                    echo -e "${RED}Password cannot be empty${NC}"
                    continue
                fi
                htpasswd -b /etc/nginx/.htpasswd_files "$NEW_FB_USER" "$NEW_FB_PASS"
                echo -e "${GREEN}✅ FileBrowser user ${NEW_FB_USER} added!${NC}"
                echo -e "${YELLOW}They can log in at: https://${FILES_DOMAIN}${NC}"
                ;;
            2)
                read -p "Enter FileBrowser username to remove: " REMOVE_FB_USER
                if [ -z "$REMOVE_FB_USER" ]; then
                    echo -e "${RED}Username cannot be empty${NC}"
                    continue
                fi
                awk -F: -v user="$REMOVE_FB_USER" '$1 != user' /etc/nginx/.htpasswd_files > /tmp/.htpasswd_files.tmp
                mv /tmp/.htpasswd_files.tmp /etc/nginx/.htpasswd_files
                echo -e "${GREEN}✅ FileBrowser user ${REMOVE_FB_USER} removed!${NC}"
                ;;
            3)
                echo -e "${YELLOW}FileBrowser users:${NC}"
                cut -d: -f1 /etc/nginx/.htpasswd_files 2>/dev/null || echo "  No users found"
                ;;
            4)
                read -p "Enter new DJ username: " NEW_DJ_USER
                if [ -z "$NEW_DJ_USER" ]; then
                    echo -e "${RED}Username cannot be empty${NC}"
                    continue
                fi
                read -sp "Enter password for ${NEW_DJ_USER}: " NEW_DJ_PASS
                echo ""
                if [ -z "$NEW_DJ_PASS" ]; then
                    echo -e "${RED}Password cannot be empty${NC}"
                    continue
                fi
                htpasswd -b /etc/nginx/.htpasswd_dj "$NEW_DJ_USER" "$NEW_DJ_PASS"
                echo -e "${GREEN}✅ DJ user ${NEW_DJ_USER} added!${NC}"
                echo -e "${YELLOW}Connection details:${NC}"
                echo "  URL: https://${DJ_DOMAIN}"
                echo "  Mount: /live.mp3"
                echo "  Username: ${NEW_DJ_USER}"
                echo "  Password: (the one you just set)"
                echo "  Icecast Source Password: ${ICECAST_SOURCE_PASS}"
                ;;
            5)
                read -p "Enter DJ username to remove: " REMOVE_DJ_USER
                if [ -z "$REMOVE_DJ_USER" ]; then
                    echo -e "${RED}Username cannot be empty${NC}"
                    continue
                fi
                awk -F: -v user="$REMOVE_DJ_USER" '$1 != user' /etc/nginx/.htpasswd_dj > /tmp/.htpasswd_dj.tmp
                mv /tmp/.htpasswd_dj.tmp /etc/nginx/.htpasswd_dj
                echo -e "${GREEN}✅ DJ user ${REMOVE_DJ_USER} removed!${NC}"
                ;;
            6)
                echo -e "${YELLOW}DJ users:${NC}"
                cut -d: -f1 /etc/nginx/.htpasswd_dj 2>/dev/null || echo "  No users found"
                ;;
            7)
                echo -e "${GREEN}Exiting user management${NC}"
                break
                ;;
            *)
                echo -e "${RED}Invalid option${NC}"
                ;;
        esac
    done
}

# ---- Run user management ----
manage_users

# ---- Final instructions ----
echo ""
echo -e "${GREEN}========================================${NC}"
echo -e "${GREEN}✅ Installation complete!${NC}"
echo -e "${GREEN}========================================${NC}"
echo ""
echo -e "${YELLOW}🔑 Your passwords:${NC}"
echo "  Icecast source: ${ICECAST_SOURCE_PASS}"
echo "  Icecast relay:  ${ICECAST_RELAY_PASS}"
echo "  Icecast admin:  ${ICECAST_ADMIN_PASS}"
echo "  FileBrowser:    ${FB_USER} / ${FB_PASS}"
echo "  DJ user:        ${DJ_USER} / ${DJ_PASS}"
echo ""
echo -e "${YELLOW}🌐 Access:${NC}"
echo "  Main website:   https://${DOMAIN}"
echo "  Listeners:      https://${PLAY_DOMAIN}"
echo "  File manager:   https://${FILES_DOMAIN}"
echo "  DJ source:      https://${DJ_DOMAIN}"
echo ""
echo -e "${YELLOW}📁 Upload music to: /var/music${NC}"
echo ""
echo -e "${YELLOW}🔧 To manage users again, run:${NC}"
echo "   sudo /usr/local/bin/manage-radio-users"
echo ""
echo -e "${YELLOW}🔧 Maintenance commands:${NC}"
echo "  Restart Icecast:      systemctl restart icecast2"
echo "  Restart Liquidsoap:   systemctl restart liquidsoap"
echo "  Update Cloudflare IPs: /usr/local/bin/update-cloudflare-ufw"
echo "  View Icecast logs:    tail -f /var/log/icecast2/error.log"
echo "  View Liquidsoap logs: tail -f /var/log/liquidsoap/radio.log"
echo "  View Nginx logs:      tail -f /var/log/nginx/*.log"
