            echo -e "${GREEN}✅ FileBrowser user ${NEW_FB_USER} added!${NC}"
            echo -e "${YELLOW}They can log in at: https://files.${DOMAIN}${NC}"
            ;;
        2)
            read -p "Enter FileBrowser username to remove: " REMOVE_FB_USER
            if [ -z "$REMOVE_FB_USER" ]; then
