#!/bin/bash

set -euo pipefail

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo -e "${GREEN}========================================${NC}"
echo -e "${GREEN}    Secure Icecast Radio Installer     ${NC}"
echo -e "${GREEN}========================================${NC}"

# ---- Gather input ----
echo ""
read -p "Enter your main domain (e.g., example.com): " DOMAIN
if [ -z "$DOMAIN" ]; then
    echo -e "${RED}Error: Domain cannot be empty${NC}"
    exit 1
fi

# Subdomains
PLAY_DOMAIN="play.${DOMAIN}"
FILES_DOMAIN="files.${DOMAIN}"
DJ_DOMAIN="dj.${DOMAIN}"

echo -e "${YELLOW}Using subdomains:${NC}"
echo "  - Listeners: ${PLAY_DOMAIN}"
echo "  - File manager: ${FILES_DOMAIN}"
echo "  - DJ source: ${DJ_DOMAIN}"
read -p "Is this correct? (y/n): " CONFIRM
if [[ ! "$CONFIRM" =~ ^[Yy]$ ]]; then
    echo "Exiting..."
    exit 0
fi

read -p "Enter your email for Let's Encrypt (optional, press Enter to skip): " EMAIL

# ---- Initial users ----
echo ""
echo -e "${GREEN}Setting up initial users...${NC}"

read -p "Enter username for FileBrowser (admin): " FB_USER
FB_USER=${FB_USER:-admin}
read -sp "Enter password for FileBrowser: " FB_PASS
echo ""
if [ -z "$FB_PASS" ]; then
    echo -e "${RED}Password cannot be empty${NC}"
    exit 1
fi

echo ""
read -p "Enter username for DJ (live source): " DJ_USER
DJ_USER=${DJ_USER:-dj}
read -sp "Enter password for DJ: " DJ_PASS
echo ""
if [ -z "$DJ_PASS" ]; then
    echo -e "${RED}Password cannot be empty${NC}"
    exit 1
fi

# Auto-generate Icecast passwords
ICECAST_SOURCE_PASS=$(openssl rand -base64 24 | tr -d '/+=')
ICECAST_RELAY_PASS=$(openssl rand -base64 24 | tr -d '/+=')
ICECAST_ADMIN_PASS=$(openssl rand -base64 24 | tr -d '/+=')

echo ""
echo -e "${YELLOW}Generated Icecast passwords:${NC}"
echo "  Source password: ${ICECAST_SOURCE_PASS}"
echo "  Relay password:  ${ICECAST_RELAY_PASS}"
echo "  Admin password:  ${ICECAST_ADMIN_PASS}"
echo ""
echo "Please save these somewhere safe."
echo ""

# ---- System update and packages ----
echo -e "${GREEN}Updating system and installing packages...${NC}"
apt update && apt upgrade -y
apt install -y nginx icecast2 liquidsoap fail2ban ufw curl certbot python3-certbot-nginx

# ---- FileBrowser ----
echo -e "${GREEN}Installing FileBrowser...${NC}"
curl -fsSL https://raw.githubusercontent.com/filebrowser/get/master/get.sh | bash
mkdir -p /var/music
chown www-data:www-data /var/music

# Initialize DB and create admin user
filebrowser -d /etc/filebrowser.db users add "$FB_USER" "$FB_PASS" --perm.admin
chown www-data:www-data /etc/filebrowser.db

cat <<EOF > /etc/systemd/system/filebrowser.service
[Unit]
Description=File Browser
After=network.target

[Service]
ExecStart=/usr/local/bin/filebrowser -r /var/music -a 127.0.0.1 -p 8080 -d /etc/filebrowser.db
Restart=always
User=www-data
Group=www-data

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable filebrowser
systemctl start filebrowser

# ---- Icecast ----
echo -e "${GREEN}Configuring Icecast...${NC}"
sed -i 's/<bind-address>.*<\/bind-address>/<bind-address>127.0.0.1<\/bind-address>/' /etc/icecast2/icecast.xml
sed -i "s/<source-password>.*<\/source-password>/<source-password>${ICECAST_SOURCE_PASS}<\/source-password>/" /etc/icecast2/icecast.xml
sed -i "s/<relay-password>.*<\/relay-password>/<relay-password>${ICECAST_RELAY_PASS}<\/relay-password>/" /etc/icecast2/icecast.xml
sed -i "s/<admin-password>.*<\/admin-password>/<admin-password>${ICECAST_ADMIN_PASS}<\/admin-password>/" /etc/icecast2/icecast.xml
sed -i '/<\/icecast>/i \
    <mount>\n        <mount-name>\/live.mp3<\/mount-name>\n        <type>application\/mpeg<\/type>\n        <bitrate>128<\/bitrate>\n    <\/mount>' /etc/icecast2/icecast.xml

systemctl enable icecast2
systemctl start icecast2

# ---- Liquidsoap ----
echo -e "${GREEN}Configuring Liquidsoap...${NC}"
mkdir -p /var/log/liquidsoap
chown -R liquidsoap:liquidsoap /var/log/liquidsoap
cat <<EOF > /etc/liquidsoap/radio.liq
#!/usr/bin/liquidsoap
set("log.file.path", "/var/log/liquidsoap/radio.log")
set("log.level", 3)

playlist = playlist("/var/music", reload_mode="watch")
radio = crossfade(playlist)

# DJ input on port 8005 (localhost only)
dj = input.harbor("dj", port=8005, password="${DJ_PASS}")

radio = fallback(track_sensitive=true, [dj, playlist])

output.icecast(
    %mp3(bitrate=128, samplerate=44100, stereo=true),
    host="127.0.0.1",
    port=8000,
    password="${ICECAST_SOURCE_PASS}",
    mount="/live.mp3",
    radio
)
EOF

systemctl enable liquidsoap
systemctl start liquidsoap

# ---- UFW: Cloudflare only ----
echo -e "${GREEN}Configuring UFW with Cloudflare IPs...${NC}"
curl -s https://www.cloudflare.com/ips-v4 -o /tmp/cf4
curl -s https://www.cloudflare.com/ips-v6 -o /tmp/cf6

ufw --force reset
ufw default deny incoming
ufw default allow outgoing

ufw allow ssh
ufw limit ssh

for ip in $(cat /tmp/cf4 /tmp/cf6); do
    ufw allow proto tcp from $ip to any port 80,443 comment 'Cloudflare'
done

ufw --force enable
ufw reload
rm -f /tmp/cf4 /tmp/cf6

# ---- Create Cloudflare update script ----
cat <<'EOF' > /usr/local/bin/update-cloudflare-ufw
#!/bin/bash
curl -s https://www.cloudflare.com/ips-v4 -o /tmp/cf4
curl -s https://www.cloudflare.com/ips-v6 -o /tmp/cf6

# Remove old Cloudflare rules
ufw status numbered | grep 'Cloudflare' | awk '{print $1}' | tr -d '[]' | tac | while read rule; do
    echo "y" | ufw delete $rule 2>/dev/null || true
done

for ip in $(cat /tmp/cf4 /tmp/cf6); do
    ufw allow proto tcp from $ip to any port 80,443 comment 'Cloudflare'
done

ufw reload
rm -f /tmp/cf4 /tmp/cf6
EOF
chmod +x /usr/local/bin/update-cloudflare-ufw

# ---- Nginx ----
echo -e "${GREEN}Configuring Nginx...${NC}"
mkdir -p /var/www/play
cat <<'EOF' > /var/www/play/index.html
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Radio – MP3 128</title>
    <style>
        body { font-family: Arial, sans-serif; text-align: center; padding: 2rem; background: #1a1a1a; color: #eee; }
        audio { width: 80%; max-width: 500px; margin: 2rem auto; display: block; }
        h1 { color: #f0a030; }
        a { color: #f0a030; }
    </style>
</head>
<body>
    <h1>🎵 My Radio – MP3 128 kbps</h1>
    <audio controls autoplay>
        <source src="/live.mp3" type="audio/mpeg">
        Your browser does not support the audio element.
    </audio>
    <p>Direct stream: <a href="/live.mp3">/live.mp3</a></p>
</body>
</html>
EOF
chown -R www-data:www-data /var/www/play

# Set up htpasswd
echo -e "${GREEN}Setting up HTTP Basic Auth...${NC}"
htpasswd -bc /etc/nginx/.htpasswd_files "$FB_USER" "$FB_PASS"
htpasswd -bc /etc/nginx/.htpasswd_dj "$DJ_USER" "$DJ_PASS"

cat <<EOF > /etc/nginx/sites-available/radio
upstream icecast     { server 127.0.0.1:8000; }
upstream filebrowser { server 127.0.0.1:8080; }
upstream liquidsoap  { server 127.0.0.1:8005; }

limit_req_zone \$binary_remote_addr zone=radio:10m rate=10r/s;

# ---- play subdomain ----
server {
    listen 443 ssl http2;
    server_name ${PLAY_DOMAIN};

    root /var/www/play;
    index index.html;

    location = / {
        try_files \$uri \$uri/ =404;
    }

    location /live.mp3 {
        proxy_pass http://icecast/live.mp3;
        proxy_buffering off;
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
    }

    location ~ ^/(admin|status|stats) {
        return 404;
    }

    location / {
        return 404;
    }
}

# ---- files subdomain ----
server {
    listen 443 ssl http2;
    server_name ${FILES_DOMAIN};

    auth_basic "Restricted Area";
    auth_basic_user_file /etc/nginx/.htpasswd_files;
    client_max_body_size 500M;

    location / {
        proxy_pass http://filebrowser;
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
    }
}

# ---- dj subdomain ----
server {
    listen 443 ssl http2;
    server_name ${DJ_DOMAIN};

    auth_basic "DJ Area";
    auth_basic_user_file /etc/nginx/.htpasswd_dj;

    location / {
        proxy_pass http://liquidsoap;
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
    }
}

# ---- HTTP to HTTPS redirect ----
server {
    listen 80;
    server_name ${PLAY_DOMAIN} ${FILES_DOMAIN} ${DJ_DOMAIN};
    return 301 https://\$host\$request_uri;
}
EOF

ln -sf /etc/nginx/sites-available/radio /etc/nginx/sites-enabled/
rm -f /etc/nginx/sites-enabled/default
nginx -t && systemctl reload nginx

# ---- Certbot hooks ----
echo -e "${GREEN}Setting up Certbot renewal hooks...${NC}"
mkdir -p /etc/letsencrypt/renewal-hooks/{pre,post}

cat <<'EOF' > /etc/letsencrypt/renewal-hooks/pre/01-ufw-allow-http.sh
#!/bin/bash
ufw allow 80/tcp comment 'Certbot Renewal' 2>/dev/null || true
ufw reload
EOF

cat <<'EOF' > /etc/letsencrypt/renewal-hooks/post/01-ufw-restore-http.sh
#!/bin/bash
RULE4=$(ufw status numbered | grep -E '80/tcp.*Certbot Renewal' | head -1 | awk '{print $1}' | tr -d '[]')
[ -n "$RULE4" ] && echo "y" | ufw delete $RULE4 2>/dev/null || true

RULE6=$(ufw status numbered | grep -E '80/tcp \(v6\).*Certbot Renewal' | head -1 | awk '{print $1}' | tr -d '[]')
[ -n "$RULE6" ] && echo "y" | ufw delete $RULE6 2>/dev/null || true

ufw reload
EOF

chmod +x /etc/letsencrypt/renewal-hooks/pre/01-ufw-allow-http.sh
chmod +x /etc/letsencrypt/renewal-hooks/post/01-ufw-restore-http.sh

# ---- Fail2ban ----
echo -e "${GREEN}Configuring fail2ban...${NC}"
cp /etc/fail2ban/jail.conf /etc/fail2ban/jail.local
cat <<EOF > /etc/fail2ban/jail.d/sshd.local
[sshd]
enabled = true
port = ssh
filter = sshd
logpath = /var/log/auth.log
maxretry = 3
bantime = 1h
EOF

systemctl enable fail2ban
systemctl restart fail2ban

# ---- SSL (if DNS ready) ----
echo ""
echo -e "${YELLOW}========================================${NC}"
echo -e "${YELLOW}IMPORTANT: DNS must point to this server${NC}"
echo -e "${YELLOW}Cloudflare DNS - Orange Cloud ON must be set${NC}"
echo -e "${YELLOW}========================================${NC}"
read -p "Has DNS been configured for ${DOMAIN} and subdomains? (y/n): " DNS_READY

if [[ "$DNS_READY" =~ ^[Yy]$ ]]; then
    if [ -n "$EMAIL" ]; then
        certbot --nginx -d ${PLAY_DOMAIN} -d ${FILES_DOMAIN} -d ${DJ_DOMAIN} --email ${EMAIL} --non-interactive --agree-tos
    else
        certbot --nginx -d ${PLAY_DOMAIN} -d ${FILES_DOMAIN} -d ${DJ_DOMAIN}
    fi
    systemctl reload nginx
    echo -e "${GREEN}✅ SSL certificate installed!${NC}"
else
    echo -e "${YELLOW}⚠️  Skipping SSL certificate installation.${NC}"
    echo -e "${YELLOW}   Run later: sudo certbot --nginx -d ${PLAY_DOMAIN} -d ${FILES_DOMAIN} -d ${DJ_DOMAIN}${NC}"
fi

# ---- USER MANAGEMENT FUNCTIONS ----
manage_users() {
    while true; do
        echo ""
        echo -e "${GREEN}========================================${NC}"
        echo -e "${GREEN}      User Management Menu            ${NC}"
        echo -e "${GREEN}========================================${NC}"
        echo ""
        echo "1. Add FileBrowser user (files.${DOMAIN})"
        echo "2. Remove FileBrowser user"
        echo "3. List FileBrowser users"
        echo "4. Add DJ user (dj.${DOMAIN})"
        echo "5. Remove DJ user"
        echo "6. List DJ users"
        echo "7. Exit user management"
        echo ""
        read -p "Select option (1-7): " USER_OPTION

        case $USER_OPTION in
            1)
                read -p "Enter new FileBrowser username: " NEW_FB_USER
                if [ -z "$NEW_FB_USER" ]; then
                    echo -e "${RED}Username cannot be empty${NC}"
                    continue
                fi
                read -sp "Enter password for ${NEW_FB_USER}: " NEW_FB_PASS
                echo ""
                if [ -z "$NEW_FB_PASS" ]; then
                    echo -e "${RED}Password cannot be empty${NC}"
                    continue
                fi
                htpasswd /etc/nginx/.htpasswd_files "$NEW_FB_USER"
                echo -e "${GREEN}✅ FileBrowser user ${NEW_FB_USER} added!${NC}"
                echo -e "${YELLOW}They can log in at: https://${FILES_DOMAIN}${NC}"
                ;;
            2)
                read -p "Enter FileBrowser username to remove: " REMOVE_FB_USER
                if [ -z "$REMOVE_FB_USER" ]; then
                    echo -e "${RED}Username cannot be empty${NC}"
                    continue
                fi
                # Create a temporary file without the user
                awk -F: -v user="$REMOVE_FB_USER" '$1 != user' /etc/nginx/.htpasswd_files > /tmp/.htpasswd_files.tmp
                mv /tmp/.htpasswd_files.tmp /etc/nginx/.htpasswd_files
                echo -e "${GREEN}✅ FileBrowser user ${REMOVE_FB_USER} removed!${NC}"
                ;;
            3)
                echo -e "${YELLOW}FileBrowser users:${NC}"
                cut -d: -f1 /etc/nginx/.htpasswd_files 2>/dev/null || echo "  No users found"
                ;;
            4)
                read -p "Enter new DJ username: " NEW_DJ_USER
                if [ -z "$NEW_DJ_USER" ]; then
                    echo -e "${RED}Username cannot be empty${NC}"
                    continue
                fi
                read -sp "Enter password for ${NEW_DJ_USER}: " NEW_DJ_PASS
                echo ""
                if [ -z "$NEW_DJ_PASS" ]; then
                    echo -e "${RED}Password cannot be empty${NC}"
                    continue
                fi
                htpasswd /etc/nginx/.htpasswd_dj "$NEW_DJ_USER"
                echo -e "${GREEN}✅ DJ user ${NEW_DJ_USER} added!${NC}"
                echo -e "${YELLOW}Connection details:${NC}"
                echo "  URL: https://${DJ_DOMAIN}"
                echo "  Mount: /live.mp3"
                echo "  Username: ${NEW_DJ_USER}"
                echo "  Password: (the one you just set)"
                echo "  Icecast Source Password: ${ICECAST_SOURCE_PASS}"
                ;;
            5)
                read -p "Enter DJ username to remove: " REMOVE_DJ_USER
                if [ -z "$REMOVE_DJ_USER" ]; then
                    echo -e "${RED}Username cannot be empty${NC}"
                    continue
                fi
                awk -F: -v user="$REMOVE_DJ_USER" '$1 != user' /etc/nginx/.htpasswd_dj > /tmp/.htpasswd_dj.tmp
                mv /tmp/.htpasswd_dj.tmp /etc/nginx/.htpasswd_dj
                echo -e "${GREEN}✅ DJ user ${REMOVE_DJ_USER} removed!${NC}"
                ;;
            6)
                echo -e "${YELLOW}DJ users:${NC}"
                cut -d: -f1 /etc/nginx/.htpasswd_dj 2>/dev/null || echo "  No users found"
                ;;
            7)
                echo -e "${GREEN}Exiting user management${NC}"
                break
                ;;
            *)
                echo -e "${RED}Invalid option${NC}"
                ;;
        esac
    done
}

# ---- Run user management ----
manage_users

# ---- Final instructions ----
echo ""
echo -e "${GREEN}========================================${NC}"
echo -e "${GREEN}✅ Installation complete!${NC}"
echo -e "${GREEN}========================================${NC}"
echo ""
echo -e "${YELLOW}🔑 Your passwords:${NC}"
echo "  Icecast source: ${ICECAST_SOURCE_PASS}"
echo "  Icecast relay:  ${ICECAST_RELAY_PASS}"
echo "  Icecast admin:  ${ICECAST_ADMIN_PASS}"
echo "  FileBrowser:    ${FB_USER} / ${FB_PASS}"
echo "  DJ user:        ${DJ_USER} / ${DJ_PASS}"
echo ""
echo -e "${YELLOW}🌐 Access:${NC}"
echo "  Listeners:      https://${PLAY_DOMAIN}"
echo "  File manager:   https://${FILES_DOMAIN}"
echo "  DJ source:      https://${DJ_DOMAIN}"
echo ""
echo -e "${YELLOW}📁 Upload music to: /var/music${NC}"
echo ""
echo -e "${YELLOW}🔧 To manage users again, run:${NC}"
echo "   sudo /usr/local/bin/manage-radio-users"
echo ""
echo -e "${YELLOW}🔧 Maintenance commands:${NC}"
echo "  Restart Icecast:      systemctl restart icecast2"
echo "  Restart Liquidsoap:   systemctl restart liquidsoap"
echo "  Update Cloudflare IPs: /usr/local/bin/update-cloudflare-ufw"
echo "  View Icecast logs:    tail -f /var/log/icecast2/error.log"
echo "  View Liquidsoap logs: tail -f /var/log/liquidsoap/radio.log"
echo ""

# ---- Create standalone user management script ----
cat <<'EOF' > /usr/local/bin/manage-radio-users
#!/bin/bash
# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

# Detect domain from nginx config
DOMAIN=$(grep -oP 'server_name \K[^;]+' /etc/nginx/sites-available/radio | head -1 | sed 's/play\.//')
ICECAST_SOURCE_PASS=$(grep -oP 'password="\K[^"]+' /etc/liquidsoap/radio.liq | head -1)

while true; do
    echo ""
    echo -e "${GREEN}========================================${NC}"
    echo -e "${GREEN}      Radio User Management            ${NC}"
    echo -e "${GREEN}========================================${NC}"
    echo ""
    echo "1. Add FileBrowser user (files.${DOMAIN})"
    echo "2. Remove FileBrowser user"
    echo "3. List FileBrowser users"
    echo "4. Add DJ user (dj.${DOMAIN})"
    echo "5. Remove DJ user"
    echo "6. List DJ users"
    echo "7. Exit"
    echo ""
    read -p "Select option (1-7): " USER_OPTION

    case $USER_OPTION in
        1)
            read -p "Enter new FileBrowser username: " NEW_FB_USER
            if [ -z "$NEW_FB_USER" ]; then
                echo -e "${RED}Username cannot be empty${NC}"
                continue
            fi
            htpasswd /etc/nginx/.htpasswd_files "$NEW_FB_USER"
            echo -e "${GREEN}✅ FileBrowser user ${NEW_FB_USER} added!${NC}"
            echo -e "${YELLOW}They can log in at: https://files.${DOMAIN}${NC}"
            ;;
        2)
            read -p "Enter FileBrowser username to remove: " REMOVE_FB_USER
            if [ -z "$REMOVE_FB_USER" ]; then
                echo -e "${RED}Username cannot be empty${NC}"
                continue
            fi
            grep -v "^${REMOVE_FB_USER}:" /etc/nginx/.htpasswd_files > /tmp/.htpasswd_files.tmp
            mv /tmp/.htpasswd_files.tmp /etc/nginx/.htpasswd_files
            echo -e "${GREEN}✅ FileBrowser user ${REMOVE_FB_USER} removed!${NC}"
            ;;
        3)
            echo -e "${YELLOW}FileBrowser users:${NC}"
            cut -d: -f1 /etc/nginx/.htpasswd_files 2>/dev/null || echo "  No users found"
            ;;
        4)
            read -p "Enter new DJ username: " NEW_DJ_USER
            if [ -z "$NEW_DJ_USER" ]; then
                echo -e "${RED}Username cannot be empty${NC}"
                continue
            fi
            htpasswd /etc/nginx/.htpasswd_dj "$NEW_DJ_USER"
            echo -e "${GREEN}✅ DJ user ${NEW_DJ_USER} added!${NC}"
            echo -e "${YELLOW}Connection details:${NC}"
            echo "  URL: https://dj.${DOMAIN}"
            echo "  Mount: /live.mp3"
            echo "  Username: ${NEW_DJ_USER}"
            echo "  Password: (the one you just set)"
            echo "  Icecast Source Password: ${ICECAST_SOURCE_PASS}"
            ;;
        5)
            read -p "Enter DJ username to remove: " REMOVE_DJ_USER
            if [ -z "$REMOVE_DJ_USER" ]; then
                echo -e "${RED}Username cannot be empty${NC}"
                continue
            fi
            grep -v "^${REMOVE_DJ_USER}:" /etc/nginx/.htpasswd_dj > /tmp/.htpasswd_dj.tmp
            mv /tmp/.htpasswd_dj.tmp /etc/nginx/.htpasswd_dj
            echo -e "${GREEN}✅ DJ user ${REMOVE_DJ_USER} removed!${NC}"
            ;;
        6)
            echo -e "${YELLOW}DJ users:${NC}"
            cut -d: -f1 /etc/nginx/.htpasswd_dj 2>/dev/null || echo "  No users found"
            ;;
        7)
            echo -e "${GREEN}Goodbye!${NC}"
            exit 0
            ;;
        *)
            echo -e "${RED}Invalid option${NC}"
            ;;
    esac
done
EOF

chmod +x /usr/local/bin/manage-radio-users

echo -e "${GREEN}✅ User management script created: /usr/local/bin/manage-radio-users${NC}"
echo -e "${GREEN}You can run it anytime to add/remove users.${NC}"
echo ""
echo -e "${GREEN}Enjoy your radio! 🎶${NC}"
