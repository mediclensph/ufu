#!/bin/bash

set -euo pipefail

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo -e "${GREEN}========================================${NC}"
echo -e "${GREEN}    The Lounge Installation Script     ${NC}"
echo -e "${GREEN}========================================${NC}"

# Get hostname from user
echo ""
read -p "Enter your domain/hostname (e.g., irc.example.com): " HOSTNAME

if [ -z "$HOSTNAME" ]; then
    echo -e "${RED}Error: Hostname cannot be empty${NC}"
    exit 1
fi

echo ""
echo -e "${YELLOW}Using hostname: ${HOSTNAME}${NC}"
echo ""
read -p "Is this correct? (y/n): " CONFIRM

if [[ ! "$CONFIRM" =~ ^[Yy]$ ]]; then
    echo "Exiting..."
    exit 0
fi

# Get email for SSL certificate
echo ""
read -p "Enter your email for Let's Encrypt (optional, press Enter to skip): " EMAIL
echo ""
echo -e "${GREEN}Starting installation...${NC}"

# System update
apt update && apt upgrade -y

# Install packages
apt install nginx certbot python3-certbot-nginx ufw fail2ban docker.io -y


# Create The Lounge directory
mkdir -p /home/docker/thelounge

# Run The Lounge container
echo -e "${GREEN}Starting The Lounge container...${NC}"
docker run -d \
  --name thelounge \
  --restart=always \
  --network host \
  -v /home/docker/thelounge:/config \
  -e PUID=1000 \
  -e PGID=1000 \
  linuxserver/thelounge

# Backup existing config if it exists
if [ -f /home/docker/thelounge/config.js ]; then
    mv /home/docker/thelounge/config.js /home/docker/thelounge/config.js.back
fi

# Create The Lounge config
cat <<'EOF' > /home/docker/thelounge/config.js
"use strict";
module.exports = {
    public: false,
    host: "127.0.0.1",
    port: 9000,
    bind: undefined,
    reverseProxy: true,
    maxHistory: 10000,
    https: {
        enable: false,
        key: "",
        certificate: "",
        ca: "",
    },
    theme: "default",
    prefetch: true,
    disableMediaPreview: false,
    prefetchStorage: false,
    prefetchMaxImageSize: 2048,
    prefetchMaxSearchSize: 50,
    prefetchTimeout: 5000,
    fileUpload: {
        enable: true,
        maxFileSize: 10240,
        baseUrl: null,
    },
    transports: ["polling", "websocket"],
    leaveMessage: "Goodbye",
    defaults: {
        name: "Undernet",
        host: "us.undernet.org",
        port: 6667,
        password: "",
        tls: false,
        rejectUnauthorized: true,
        nick: "mynick%%",
        keepNick: true,
        username: "myusername",
        realname: "myname",
        join: "#whatever",
        leaveMessage: "Goodbye",
    },
    lockNetwork: false,
    messageStorage: ["sqlite", "text"],
    storagePolicy: {
        enabled: false,
        maxAgeDays: 3,
        deletionPolicy: "statusOnly",
    },
    useHexIp: false,
    webirc: null,
    identd: {
        enable: false,
        port: 113,
    },
    oidentd: null,
    ldap: {
        enable: false,
        url: "ldaps://example.com",
        tlsOptions: {},
        primaryKey: "uid",
        searchDN: {
            rootDN: "cn=thelounge,ou=system-users,dc=example,dc=com",
            rootPassword: "1234",
            filter: "(&(objectClass=person)(memberOf=ou=accounts,dc=example,dc=com))",
            base: "dc=example,dc=com",
            scope: "sub",
        },
    },
    debug: {
        ircFramework: false,
        raw: false,
    },
};
EOF

# Restart The Lounge to apply config
docker restart thelounge

# Wait for The Lounge to start
sleep 5

# Create Nginx config
echo -e "${GREEN}Configuring Nginx for ${HOSTNAME}...${NC}"
cat <<EOF > /etc/nginx/sites-available/thelounge
server {
    listen 80;
    listen [::]:80;
    server_name ${HOSTNAME};

    client_max_body_size 10M;

    location / {
        proxy_pass http://127.0.0.1:9000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host \$host;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
    }
}
EOF

# Enable Nginx site
ln -sf /etc/nginx/sites-available/thelounge /etc/nginx/sites-enabled/
rm -f /etc/nginx/sites-enabled/default

# Test and reload Nginx
nginx -t
systemctl reload nginx


# Get the Cloudflare IPs
curl -s https://www.cloudflare.com/ips-v4 -o /tmp/cloudflare_ips_$$
echo "" >> /tmp/cloudflare_ips_$$
curl -s https://www.cloudflare.com/ips-v6 >> /tmp/cloudflare_ips_$$

# Reset the firewall to clean stuff.
ufw --force reset
ufw default deny incoming
ufw default allow outgoing
ufw allow ssh
ufw limit ssh
for ip in $(cat /tmp/cloudflare_ips_$$)
do
  ufw allow proto tcp from $ip comment 'Cloudflare'
done
# Make sure the firewall is enabled and started, as the above command
# stops it.
ufw enable
ufw reload > /dev/null
ufw status numbered
rm -rf /tmp/cloudflare_ips_$$

# Configure fail2ban
echo -e "${GREEN}Configuring fail2ban for SSH protection...${NC}"

# Backup original config
if [ ! -f /etc/fail2ban/jail.local ]; then
    cp /etc/fail2ban/jail.conf /etc/fail2ban/jail.local
fi

# Create jail.d directory
mkdir -p /etc/fail2ban/jail.d

# Get current IPs
echo -e "${YELLOW}Detecting your IP addresses...${NC}"

WHITELIST="127.0.0.1/8 ::1"

# Get IPv4
IPV4=$(ip route get 8.8.8.8 2>/dev/null | grep -oP 'src \K\S+' || echo "")
if [ -z "$IPV4" ]; then
    IPV4=$(hostname -I 2>/dev/null | awk '{print $1}' | grep -E '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$' || echo "")
fi

# Get IPv6
IPV6=$(ip -6 addr show scope global 2>/dev/null | grep -v "::1" | grep inet6 | awk '{print $2}' | cut -d/ -f1 | head -1 || echo "")

# Add to whitelist
if [ -n "$IPV4" ]; then
    WHITELIST="${WHITELIST} ${IPV4}"
    echo -e "${GREEN}✅ IPv4 detected: ${IPV4}${NC}"
fi
if [ -n "$IPV6" ]; then
    WHITELIST="${WHITELIST} ${IPV6}"
    echo -e "${GREEN}✅ IPv6 detected: ${IPV6}${NC}"
fi
if [ -z "$IPV4" ] && [ -z "$IPV6" ]; then
    echo -e "${YELLOW}⚠️  Could not detect your IP. Only localhost is whitelisted.${NC}"
fi

# Create main jail configuration
cat <<EOF > /etc/fail2ban/jail.d/00-defaults.conf
[DEFAULT]
# Ban duration (in seconds)
bantime = 10m

# Time frame for detection (in seconds)
findtime = 10m

# Number of failures before ban
maxretry = 5

# Action to take
action = %(action_mwl)s

# Whitelist IPs
ignoreip = ${WHITELIST}
EOF

# Create SSH jail configuration
cat <<EOF > /etc/fail2ban/jail.d/sshd.local
[sshd]
enabled = true
port = ssh
filter = sshd
logpath = /var/log/auth.log
maxretry = 3
bantime = 1h
ignoreip = ${WHITELIST}
EOF

# Restart and enable fail2ban
echo -e "${YELLOW}Restarting fail2ban...${NC}"
systemctl restart fail2ban
systemctl enable fail2ban
echo -e "${GREEN}✅ fail2ban has been configured and activated...${NC}"

echo -e "${GREEN}Creating Certbot hooks...${NC}"
mkdir -p /etc/letsencrypt/renewal-hooks/{pre,post}

# Configure Certbot renewal hooks for UFW
echo -e "${GREEN}Configuring Certbot renewal hooks...${NC}"

# Pre-hook: Allow port 80 for Let's Encrypt validation
cat <<'EOF' > /etc/letsencrypt/renewal-hooks/pre/01-ufw-allow-http.sh
#!/bin/bash
# Temporarily allow port 80 for Let's Encrypt validation
ufw allow 80/tcp comment 'Certbot Renewal' 2>/dev/null || true
ufw reload
EOF

# Post-hook: Remove the temporary port 80 rules
cat <<'EOF' > /etc/letsencrypt/renewal-hooks/post/01-ufw-restore-http.sh
#!/bin/bash
# Remove both IPv4 and IPv6 temporary port 80 rules

# Delete IPv4 rule
RULE4=$(ufw status numbered | grep -E '80/tcp.*Certbot Renewal' | head -1 | awk '{print $1}' | tr -d '[]')
if [ -n "$RULE4" ]; then
    echo "y" | ufw delete $RULE4 2>/dev/null || true
fi

# Delete IPv6 rule
RULE6=$(ufw status numbered | grep -E '80/tcp \(v6\).*Certbot Renewal' | head -1 | awk '{print $1}' | tr -d '[]')
if [ -n "$RULE6" ]; then
    echo "y" | ufw delete $RULE6 2>/dev/null || true
fi

ufw reload
EOF

chmod +x /etc/letsencrypt/renewal-hooks/pre/01-ufw-allow-http.sh
chmod +x /etc/letsencrypt/renewal-hooks/post/01-ufw-restore-http.sh

echo -e "${GREEN}✅ Certbot hooks configured!${NC}"

# Get SSL certificate if DNS is configured
echo ""
echo -e "${YELLOW}========================================${NC}"
echo -e "${YELLOW}IMPORTANT: DNS must point to this server${NC}"
echo -e "${YELLOW}Cloudflare DNS - Orange Cloud ON must be set ${NC}"
echo -e "${YELLOW}========================================${NC}"
echo ""
read -p "Has DNS been configured for ${HOSTNAME}? (y/n): " DNS_READY

if [[ "$DNS_READY" =~ ^[Yy]$ ]]; then
    if [ -n "$EMAIL" ]; then
        certbot --nginx -d ${HOSTNAME} --email ${EMAIL} --non-interactive --agree-tos
    else
        certbot --nginx -d ${HOSTNAME}
    fi
    systemctl reload nginx
    echo -e "${GREEN}✅ SSL certificate installed!${NC}"
else
    echo -e "${YELLOW}⚠️  Skipping SSL certificate installation.${NC}"
    echo -e "${YELLOW}   Run: sudo certbot --nginx -d ${HOSTNAME}${NC}"
fi
# Auto-delete uploaded files after 1 hour
echo -e "${GREEN}✅ Activating Auto Deleting of Uploaded files after 1 Hour ${NC}"
mkdir -p /home/docker/thelounge/uploads
if (crontab -l 2>/dev/null; echo "0 * * * * find /home/docker/thelounge/uploads/* -mmin +60 -delete 2>/dev/null") | crontab - 2>/dev/null; then
    echo -e "${GREEN}✅ Activated !! ${NC}"
else
    echo -e "${YELLOW}⚠️  Could not add cron job. Check permissions.${NC}"
fi
echo ""
echo -e "${GREEN}========================================${NC}"
echo -e "${GREEN}✅ Installation complete!${NC}"
echo -e "${GREEN}========================================${NC}"
echo ""
echo -e "${YELLOW}📝 Create users with:${NC}"
echo "  docker exec -it thelounge s6-setuidgid abc thelounge add <username>"
echo ""
echo -e "${YELLOW}🌐 Visit:${NC}"
echo "  https://${HOSTNAME}"
echo ""
echo -e "${YELLOW}🔧 User Management:${NC}"
echo "  Add user:      docker exec -it thelounge s6-setuidgid abc thelounge add <username>"
echo "  Remove user:   docker exec -it thelounge s6-setuidgid abc thelounge remove <username>"
echo "  Reset password: docker exec -it thelounge s6-setuidgid abc thelounge reset <username>"
echo "  List users:    docker exec -it thelounge s6-setuidgid abc thelounge list"
echo ""
echo -e "${YELLOW}🔧 Maintenance:${NC}"
echo "  View logs:     docker logs thelounge"
echo "  Restart:       docker restart thelounge"
echo "  Update:        docker pull linuxserver/thelounge && docker restart thelounge"
echo ""
